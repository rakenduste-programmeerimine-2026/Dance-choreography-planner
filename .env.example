# Copy to .env.local and fill in. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Read by supabase/config.jsonc for local Google sign-in. The Supabase CLI reads these
# from the shell or from supabase/.env, not from .env.local.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
